   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Main Contract: between the company and its client. Subcontract: between the company and a subcontractor it engages."
  },
  {
   "fieldname": "party_name",
   "fieldtype": "Data",
   "label": "Other Party",
