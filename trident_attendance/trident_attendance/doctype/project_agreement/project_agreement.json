   "label": "Status",
   "options": "Not Signed\nSigned, Incomplete\nComplete",
   "default": "Not Signed",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Set by the system from the fields below."
  },
  {
   "fieldname": "signed_section",
   "fieldtype": "Section Break",
   "label": "Signed agreement"
  },
  {
   "fieldname": "signed_on",
   "fieldtype": "Date",
   "label": "Signed On",
   "description": "The date both parties had signed. Cannot be in the future."
  },
  {
   "fieldname": "agreement_document",
   "fieldtype": "Attach",
   "label": "Signed Agreement",
   "description": "The scan of the signed agreement, award letter or LPO."
